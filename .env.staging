APP_NAME="KURSA Marketplace"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=csl-mysql-marketplace
DB_PORT=3306
DB_DATABASE=csl_marketplace_db
DB_USERNAME=marketplace_user
DB_PASSWORD="Marketplace2024!Secure"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=${REDIS_HOST:-127.0.0.1}
REDIS_PASSWORD=${REDIS_PASSWORD:-null}
REDIS_PORT=${REDIS_PORT:-6379}

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@csl-brands.com"
MAIL_FROM_NAME="CSL Marketplace"

AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
AWS_BUCKET=${AWS_BUCKET}
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Main API (CSL-Certification-Rest-API)
MAIN_API_URL=${MAIN_API_URL:-csl-certification-rest-api:8080}
INTERNAL_SERVICE_SECRET=${INTERNAL_SERVICE_SECRET}

# Kafka
KAFKA_BROKERS=${KAFKA_BROKERS:-csl-kafka:9092}

# Tara Money Payment Gateway
TARAMONEY_BASE_URL=https://pay.taramoney.com
TARAMONEY_MERCHANT_ID=${TARAMONEY_MERCHANT_ID:-KURSA_MARKETPLACE}
TARAMONEY_API_KEY=${TARAMONEY_API_KEY}
TARAMONEY_WEBHOOK_SECRET=${TARAMONEY_WEBHOOK_SECRET}
